# SIH26153 — Environment configuration
# Copy this file to .env and fill in your values.
# The .env file is gitignored — never commit it.

# ── Flask ──────────────────────────────────────────────────
FLASK_SECRET_KEY=change-me-to-something-random-in-production
FLASK_DEBUG=0
PORT=5000

# ── Feature flags ──────────────────────────────────────────
# Set to 0 to disable optional pipeline layers
ENABLE_FORECASTING_MODEL=1
ENABLE_KILLCHAIN=1

# ── Optional: external keys (not used in current build) ───
# GROQ_API_KEY=
# GEMINI_API_KEY=
